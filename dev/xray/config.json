{
  "log": {
    "loglevel": "warning"
  },
  "api": {
    "tag": "api",
    "listen": "0.0.0.0:10085",
    "services": ["HandlerService"]
  },
  "inbounds": [
    {
      "tag": "nginx-xhttp-in",
      "listen": "0.0.0.0",
      "port": 10800,
      "protocol": "vless",
      "settings": {
        "clients": [
          { "id": "aaaaaaaa-0000-4000-8000-000000000001", "email": "me" },
          { "id": "aaaaaaaa-0000-4000-8000-000000000002", "email": "ilya" }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "/api/v1/project/sync",
          "mode": "auto"
        }
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom" }
  ]
}